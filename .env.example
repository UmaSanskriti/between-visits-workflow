# Copy to .env (gitignored). Never commit real values.
VAPI_API_KEY=
BV_LIVE_ALLOWLIST=+15555550100
# Optional: pick a specific Vapi phone number to dial from; otherwise the first active one is used
VAPI_PHONE_NUMBER_ID=
# Optional: the number the agent gives for call backs; defaults to the Vapi number it dials from
BV_CALLBACK_NUMBER=
# Twilio number to import into Vapi (python -m infra vapi import-twilio)
TWILIO_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Email outreach (python -m infra email-demo --send). Gmail: smtp.gmail.com, port 587, an App Password.
EMAIL_FROM=
EMAIL_FROM_NAME=Anirudh Bagla
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: poll replies over IMAP (Gmail: imap.gmail.com). Defaults to the SMTP user/password.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# Practice sheet on Google Sheets (python -m infra sheet bootstrap-google). Leave empty to use data/practices.xlsx.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional: force a backend (google | xlsx); default auto
BV_SHEET_BACKEND=
