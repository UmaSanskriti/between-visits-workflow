# Copy to .env (gitignored). Never commit real values.
VAPI_API_KEY=
BV_LIVE_ALLOWLIST=+15555550100
# Optional: pick a specific Vapi phone number to dial from; otherwise the first active one is used
VAPI_PHONE_NUMBER_ID=
# Optional: the number the agent gives for call backs; defaults to the Vapi number it dials from
BV_CALLBACK_NUMBER=
# Twilio number to import into Vapi (python -m infra vapi import-twilio)
TWILIO_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
